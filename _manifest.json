{
  "manifest_version": 2,
  "version": "2.7.0",
  "name": "群管理助手",
  "description": "QQ 群的自动小管理员：自动识别群主/管理员，广告、刷屏、辱骂自动警告、禁言、踢出；群公告、撤回消息、设精华、入群审批全支持，权限决策链可逐步排查；内置 /mute、/kick、/warn 等 29 个命令，配置群号即可开箱即用。",
  "author": {
    "name": "DeepSeek-V4",
    "url": "https://github.com/DeepSeek-V4-Pro"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/DeepSeek-V4-Pro/maimai_group_admin",
    "homepage": "https://github.com/DeepSeek-V4-Pro/maimai_group_admin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.11.0"
    }
  ],
  "capabilities": [
    "api.call",
    "send.text",
    "send.hybrid"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "deepseek-v4-pro.maimai-group-admin"
}
