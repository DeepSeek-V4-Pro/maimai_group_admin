{
  "manifest_version": 2,
  "version": "2.4.0",
  "name": "群管理助手",
  "description": "群管理助手 v2.4 — 给 QQ 群装一个自动小管理员：广告/刷屏/骂人自动警告、禁言、踢出，支持群公告、撤回消息、设精华、入群审批，以及 /mute、/kick、/warn 等快捷命令。配置群号即可使用。",
  "author": {
    "name": "DeepSeek-V4",
    "url": "https://github.com/DeepSeek-V4-Pro"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/DeepSeek-V4-Pro/maimai_group_admin",
    "homepage": "https://github.com/DeepSeek-V4-Pro/maimai_group_admin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.11.0"
    }
  ],
  "capabilities": [
    "api.call",
    "send.text",
    "send.hybrid"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "deepseek-v4-pro.maimai-group-admin"
}
